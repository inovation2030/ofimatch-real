# OfiMatch — variables de entorno. Copia este archivo a .env y llena TUS valores.
# NUNCA subas el .env a git ni compartas el Access Token por chat.
PORT=3000
# Secreto para firmar las sesiones (cámbialo en producción por uno largo y aleatorio)
JWT_SECRET=cambia-este-secreto-en-produccion
# Mercado Pago — producción (servidor, nunca en el frontend)
# Se consigue en Mercado Pago Developers > Tus integraciones > tu aplicación > Credenciales
MERCADOPAGO_ACCESS_TOKEN=
# Mercado Pago — clave pública (frontend, no es secreta)
MERCADOPAGO_PUBLIC_KEY=
# Si DEMO_SEED=1, scripts/seed-demo.js crea cuentas DEMO. Apagado por defecto.
# DEMO_SEED=0
